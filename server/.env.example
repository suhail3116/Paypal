PORT=8000

# ------------------------------------------------------------------------------
# 1. AI Engine Configuration (Groq / Gemini / Ollama Hybrid)
# ------------------------------------------------------------------------------
# Free Cloud AI Option 1: Groq (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Free Cloud AI Option 2: Google Gemini (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Free Offline AI Option 3: Ollama (Already installed on your machine)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# 2. PayPal Developer Sandbox Configuration
# ------------------------------------------------------------------------------
# Get your Sandbox Client ID and Secret from https://developer.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret

# ------------------------------------------------------------------------------
# 3. WhatsApp Business Cloud API Configuration
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=shoppilot_webhook_secret

# ------------------------------------------------------------------------------
# 4. Optional Supabase Configuration (When deploying to production)
# ------------------------------------------------------------------------------
# Leave blank to use local embedded zero-config database
SUPABASE_URL=
SUPABASE_KEY=
